<?xml version="1.0" encoding="UTF-8" ?>
<templates id="web_digital_sign_templates" xml:space="preserve">
    <t t-name="web_digital_sign.FieldDigitalSignature" owl="1">
        <div class="o_field_signature">

            <t t-if="state.isLoading">
                <div class="text-center p-3">
                    <i class="fa fa-spinner fa-spin"/> Loading signature widget...
                </div>
            </t>

            <t t-elif="!isReadonly">
                <div class="card mt-3 mb-0 o_web_sign_container">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Signature</span>
                        <div>
                            <button type="button"
                                    class="btn btn-sm btn-secondary"
                                    t-on-click="onClearSign">
                                Clear
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    t-on-click="onSaveSign">
                                Save
                            </button>
                        </div>
                    </div>
                    <div class="signature" t-ref="signature"></div>
                </div>
            </t>

            <t t-else="">
                <div class="card mt-3 mb-0">
                    <div class="card-body p-0">
                        <img t-if="imageUrl"
                             t-att-src="imageUrl"
                             class="img-fluid"
                             alt="Signature"/>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
