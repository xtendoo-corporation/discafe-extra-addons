<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de la vista de formulario de loyalty.program -->
    <record id="loyalty_program_view_form_amortization" model="ir.ui.view">
        <field name="name">loyalty.program.view.form.amortization</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar el campo amortization después de la descripción del programa buy_x_get_y -->
            <xpath expr="//field[@name='program_type']/following-sibling::p[@invisible=&quot;program_type != 'buy_x_get_y'&quot;]" position="after">
                <field name="amortization"
                       invisible="program_type != 'buy_x_get_y'"
                       class="oe_inline"/>
            </xpath>
        </field>
    </record>
</odoo>

