<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_partner_show_accounts" model="ir.ui.view">
            <field name="name">res.partner.show_account</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//list" position="inside">
                    <field name="ref" optional="show"/>
                    <field name="property_account_receivable_id" optional="hide"/>
                    <field name="property_account_payable_id" optional="hide"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
