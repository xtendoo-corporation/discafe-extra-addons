<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_expiry_fix" model="ir.ui.view">
        <field name="name">product.template.only.form.expiry.fix</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="lot_valuated" position="after">
                <field name="use_expiration_date" string="Fecha de caducidad" invisible="tracking == 'none'"/>
            </field>
            <group name="group_standard_price" position="after">
                <group string="Fechas de caducidad" name="expiry_and_lots" groups="stock.group_production_lot" invisible="tracking == 'none' or not use_expiration_date">
                    <label for="expiration_time"/>
                    <div>
                        <field name="expiration_time" class="oe_inline"/>
                        <span> días desde la recepción</span>
                    </div>
                    <label for="use_time"/>
                    <div>
                        <field name="use_time" class="oe_inline"/>
                        <span> días antes de la fecha de caducidad</span>
                    </div>
                    <label for="removal_time"/>
                    <div>
                        <field name="removal_time" class="oe_inline"/>
                        <span> días antes de la fecha de caducidad</span>
                    </div>
                    <label for="alert_time"/>
                    <div>
                        <field name="alert_time" class="oe_inline"/>
                        <span> días antes de la fecha de caducidad</span>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
