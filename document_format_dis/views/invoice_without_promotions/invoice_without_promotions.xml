<?xml version="1.0" encoding="UTF-8"?>
<!-- Esta vista se encarga de llamar solo a la vista de facturas sin promociones -->
<!-- Este reporte se puede imprimir desde: Contabilidad > Clientes > Facturas > Imprimir > Factura Sin Promociones -->
<odoo>
    <data>

        <!-- Report NUEVO con ID distinto -->
        <report
            id="report_invoice_without_promotions_new"
            string="Factura Sin Promociones"
            model="account.move"
            report_type="qweb-pdf"
            name="document_format_dis.report_invoice_without_promotions"
            file="account.report_invoice_without_promotions"
            print_report_name="(object._get_report_base_filename())"
        />

        <!-- Plantilla asociada al reporte -->
        <template id="document_format_dis.report_invoice_without_promotions">
            <t t-name="document_format_dis.report_invoice_without_promotions">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-set="lang" t-value="o.user_id.lang if o.type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                        <t t-call="document_format_dis.report_invoice_document_without_promotions" t-lang="lang"/>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
