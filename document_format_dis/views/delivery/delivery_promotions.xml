<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Comentario migración Odoo 18: acción equivalente al report legacy de Odoo 12. -->
        <record id="report_delivery_promotions_action" model="ir.actions.report">
            <field name="name">Vale de Entrega</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">document_format_dis.report_delivery_promotions</field>
            <field name="report_file">document_format_dis.report_delivery_promotions</field>
            <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_delivery_promotions">
            <!-- Comentario migración Odoo 18: se conserva el flujo original, primero líneas normales y después promociones. -->
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="document_format_dis.report_delivery_document_without_promotions" t-lang="(o.partner_id.lang if o.partner_id else o.env.lang)"/>
                    <t t-call="document_format_dis.report_delivery_document_promotions" t-lang="(o.partner_id.lang if o.partner_id else o.env.lang)"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
