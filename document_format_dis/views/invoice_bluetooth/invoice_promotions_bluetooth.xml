<?xml version="1.0" encoding="UTF-8"?>
<!-- Esta vista se encarga de llamar a las dos vistas de albarán bluetooth -->
<!-- Este reporte se puede imprimir desde: Contabilidad > Clientes > Facturas > Imprimir > Factura Bluetooth -->
<odoo>

    <data>

        <record id="bluetooth_invoice_2" model="report.paperformat">
            <field name="name">Bluetooth Invoice</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">3</field>
            <field name="margin_right">1.5</field>
            <field name="margin_left">1.5</field>
            <field name="page_height">500</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="header_line">False</field>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>

        <!-- Definición del reporte para Facturas -->
        <report id="document_format_dis.report_invoice_promotions_bluetooth_action"
                string="Factura Bluetooth"
                model="account.move"
                report_type="qweb-pdf"
                name="document_format_dis.report_invoice_promotions_bluetooth"
                file="account.report_invoice_promotions_bluetooth"
                print_report_name="'Invoice Slip - %s - %s' % (object.partner_id.name or '', object.name)"
        />

        <!-- Acción del reporte con el formato de papel corregido -->
        <record id="document_format_dis.report_invoice_promotions_bluetooth_action" model="ir.actions.report">
            <field name="name">Factura Bluetooth</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">document_format_dis.report_invoice_promotions_bluetooth</field>
            <field name="paperformat_id" ref="document_format_dis.bluetooth_invoice_2"/>
        </record>

        <!-- Plantilla del reporte -->
        <template id="document_format_dis.report_invoice_promotions_bluetooth">
            <t t-name="document_format_dis.report_invoice_promotions_bluetooth">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="document_format_dis.report_invoice_document_bluetooth_without_promotions" t-lang="o.partner_id.lang"/>
                        <t t-call="document_format_dis.report_invoice_document_bluetooth_with_promotions" t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>

    </data>

</odoo>
