<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_with_description">
            <t t-name="document_format_dis.report_invoice_document_with_description">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="is_customer_refund" t-value="o.move_type == 'out_refund'"/>
                    <t t-set="display_discount" t-value="any(line.discount for line in o.invoice_line_ids if (not line.display_type or line.display_type == 'product') and line.price_unit &gt; 0.0)"/>
                    <t t-set="lines_to_print" t-value="[line for line in o.invoice_line_ids if line.display_type in ('line_section', 'line_note') or (((not line.display_type) or line.display_type == 'product') and line.price_unit &gt; 0.0)]"/>
                    <t t-set="tax_totals" t-value="o.tax_totals"/>

                    <div class="page">
                        <!-- Comentario migración Odoo 18: versión con descripción ampliada basada en account.move y tax_totals. -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <ul class="list-unstyled mb-0">
                                    <li>
                                        <strong>
                                            <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</t>
                                            <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Borrador de factura</t>
                                            <t t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura cancelada</t>
                                            <t t-elif="o.move_type == 'out_refund'">Factura Rectificativa</t>
                                            <t t-elif="o.move_type == 'in_refund'">Vendor Credit Note</t>
                                            <t t-elif="o.move_type == 'in_invoice'">Vendor Bill</t>
                                            <t t-else="">Factura</t>
                                        </strong>
                                        <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                                    </li>
                                    <li t-if="'delivery_zone_id' in o._fields and o.delivery_zone_id">
                                        <strong>Zona:</strong>
                                        <span t-field="o.delivery_zone_id"/>
                                    </li>
                                    <li t-if="o.invoice_date">
                                        <strong>Fecha:</strong>
                                        <span t-field="o.invoice_date"/>
                                    </li>
                                    <li t-if="o.invoice_origin">
                                        <strong>Origen:</strong>
                                        <span t-field="o.invoice_origin"/>
                                    </li>
                                    <li t-if="o.partner_id.ref">
                                        <strong>Ref. Cliente:</strong>
                                        <span t-field="o.partner_id.ref"/>
                                    </li>
                                    <li t-if="o.move_type == 'out_refund' and o.ref">
                                        <strong>Motivo:</strong>
                                        <span t-field="o.ref"/>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-6">
                                <ul class="list-unstyled mb-0">
                                    <li t-if="o.partner_id.name"><span t-field="o.partner_id.name"/></li>
                                    <li t-if="'comercial' in o.partner_id._fields and o.partner_id.comercial"><span t-field="o.partner_id.comercial"/></li>
                                    <li t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></li>
                                    <li>
                                        <span t-if="o.partner_id.zip" t-field="o.partner_id.zip"/>
                                        <span t-if="o.partner_id.city">
                                            <t t-if="o.partner_id.zip"> </t>
                                            <span t-field="o.partner_id.city"/>
                                        </span>
                                        <t t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id"/></t>
                                    </li>
                                    <li t-if="o.partner_id.vat">
                                        <strong>CIF:</strong>
                                        <span t-field="o.partner_id.vat"/>
                                    </li>
                                </ul>
                                <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" class="mt-2">
                                    <strong>Dirección de entrega:</strong>
                                    <ul class="list-unstyled mb-0">
                                        <li t-if="o.partner_shipping_id.name"><span t-field="o.partner_shipping_id.name"/></li>
                                        <li t-if="o.partner_shipping_id.street"><span t-field="o.partner_shipping_id.street"/></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <table class="table table-sm table-borderless" style="font-size: 0.9em; width: 100%;">
                            <thead style="border-top: 2px solid black; border-bottom: 2px solid black;">
                                <tr>
                                    <th class="text-start" style="width: 13%;">Código</th>
                                    <th class="text-start" style="width: 15%;">Lote</th>
                                    <th class="text-start" style="width: 26%;">Descripción</th>
                                    <th class="text-end" style="width: 7%;">Uds.</th>
                                    <th class="text-end" style="width: 10%;">Precio/Ud</th>
                                    <th t-if="display_discount" class="text-end" style="width: 10%;" groups="product.group_discount_per_so_line">Des.(%)</th>
                                    <th class="text-end" style="width: 12%;">Valor neto</th>
                                    <th class="text-end" style="width: 7%;">IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines_to_print" t-as="line">
                                    <tr t-if="line.display_type in ('line_section', 'line_note')">
                                        <td colspan="99">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                    <tr t-elif="(not line.display_type or line.display_type == 'product') and line.product_id" style="border-bottom: 1px solid #000;">
                                        <t t-set="tax_labels" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                        <td class="text-start">
                                            <span t-field="line.product_id.default_code"/>
                                        </td>
                                        <td class="text-start">
                                            <t t-if="'prod_lot_ids' in line._fields and line.prod_lot_ids">
                                                <t t-foreach="line.prod_lot_ids" t-as="lot">
                                                    <span t-field="lot.name"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td class="text-start">
                                            <span t-esc="line.name or line.product_id.display_name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="is_customer_refund">-</span>
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-if="is_customer_refund">-</span>
                                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="tax_labels"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <hr style="height: 2px; background-color: black; clear: both; margin-bottom: 12px; border: 0; opacity: 1;"/>

                        <div class="row justify-content-end">
                            <div class="col-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Base Imponible</strong></td>
                                        <td class="text-end">
                                            <span t-if="is_customer_refund">-</span>
                                            <span t-out="tax_totals.get('formatted_amount_untaxed', '')"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                                        <t t-set="subtotal_name" t-value="subtotal.get('name', '')"/>
                                        <t t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])" t-as="amount_by_group">
                                            <tr>
                                                <td>
                                                    <span t-out="amount_by_group.get('tax_group_name', '')"/>
                                                    <t t-if="len(tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])) &gt; 1 or tax_totals.get('amount_untaxed', 0) != amount_by_group.get('tax_group_base_amount', 0)">
                                                        <span> sobre </span>
                                                        <span t-out="amount_by_group.get('formatted_tax_group_base_amount', '')"/>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-if="is_customer_refund">-</span>
                                                    <span t-out="amount_by_group.get('formatted_tax_group_amount', '')"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr style="border-top: 2px solid black; font-weight: bold;">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <span t-if="is_customer_refund">-</span>
                                            <span t-out="tax_totals.get('formatted_amount_total', '')"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div t-if="('digital_signature' in o._fields and o.digital_signature) or ('signature' in o._fields and o.signature)" class="mt-4" style="width: 30%; border: 2px solid black; padding: 8px;">
                            <!-- Comentario migración Odoo 18: se soporta tanto firma legacy como firma estándar si existiera. -->
                            <span style="text-align: center; display: block; width: 100%;">Firma del cliente:</span>
                            <img t-if="'digital_signature' in o._fields and o.digital_signature" t-att-src="image_data_uri(o.digital_signature)" style="width: 100%; max-height: 4cm; object-fit: contain;"/>
                            <img t-elif="'signature' in o._fields and o.signature" t-att-src="image_data_uri(o.signature)" style="width: 100%; max-height: 4cm; object-fit: contain;"/>
                        </div>

                        <div t-if="'payment_mode_id' in o._fields and o.payment_mode_id and o.payment_mode_id.name == 'Transferencia Santander - 1009' and o.payment_mode_id.note" style="width:60%; float:right; clear:both; margin-top:50px;">
                            <span>Transferencia:</span>
                            <span t-field="o.payment_mode_id.note"/>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </template>
    </data>

</odoo>
