<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="report_purchase_document_body">
            <!-- Comentario migración Odoo 18: se mantiene la maquetación DIS de Odoo 12 sobre purchase.order y tax_totals actuales. -->
            <t t-set="partner" t-value="o.partner_id.commercial_partner_id if o.partner_id else False"/>
            <t t-set="lines_to_print" t-value="[line for line in o.order_line if line.display_type in ('line_section', 'line_note') or (not line.display_type and line.price_unit &gt; 0.0)]"/>
            <t t-set="display_discount" t-value="any((not line.display_type) and line.discount for line in o.order_line)"/>
            <t t-set="tax_totals" t-value="o.tax_totals"/>

            <div class="page">
                <div style="width:50%; float:left; margin-top:10px;">
                    <ul class="list-unstyled mb-0">
                        <li t-if="o.state == 'draft'"><b>Presupuesto: </b><span t-field="o.name"/></li>
                        <li t-if="o.state in ['sent', 'to approve', 'purchase', 'done']"><b>Pedido: </b><span t-field="o.name"/></li>
                        <li t-if="o.state == 'cancel'"><b>Pedido cancelado: </b><span t-field="o.name"/></li>
                        <li t-if="o.date_order">
                            <b>Fecha: </b>
                            <span t-esc="o.date_order.strftime('%d/%m/%Y')"/>
                        </li>
                        <li t-if="o.payment_term_id">
                            <b>Términos de pago: </b>
                            <span t-field="o.payment_term_id"/>
                        </li>
                        <li t-if="o.partner_ref">
                            <b>Ref. Proveedor: </b>
                            <span t-field="o.partner_ref"/>
                        </li>
                    </ul>
                </div>

                <div style="width:50%; float:left; margin-top:10px;">
                    <ul class="list-unstyled mb-0">
                        <li t-if="partner and 'comercial' in partner._fields and partner.comercial">
                            <span t-field="partner.comercial"/>
                        </li>
                        <li t-if="partner and partner.name">
                            <span t-field="partner.name"/>
                        </li>
                        <li t-if="partner and partner.street">
                            <span t-field="partner.street"/>
                        </li>
                        <li t-if="partner and (partner.zip or partner.city or partner.country_id)">
                            <span t-if="partner.zip" t-field="partner.zip"/>
                            <span t-if="partner.city">
                                <span t-if="partner.zip"> </span>
                                <span t-field="partner.city"/>
                            </span>
                            <span t-if="partner.country_id">
                                <span t-if="partner.zip or partner.city">, </span>
                                <span t-field="partner.country_id"/>
                            </span>
                        </li>
                        <li t-if="partner and partner.vat">
                            <span>CIF: </span>
                            <span t-field="partner.vat"/>
                        </li>
                    </ul>
                </div>

                <div style="clear:both;"/>

                <div class="oe_structure"/>

                <div style="width:100%; clear:both;">
                    <div style="border-bottom:2px solid black; border-right:2px solid black; border-top:2px solid black; border-left:1px solid black; min-height:25px; clear:both;">
                        <div class="text-left" style="font-weight:bolder; color:#4f4b4b; width:13%; float:left;">
                            <span>Código</span>
                        </div>
                        <div class="text-left" style="font-weight:bolder; color:#4f4b4b; float:left; width:41%;">
                            <span>Descripción</span>
                        </div>
                        <div class="text-right" style="font-weight:bolder; color:#4f4b4b; float:left; width:7%;">
                            <span>Uds.</span>
                        </div>
                        <div class="text-right" style="font-weight:bolder; color:#4f4b4b; float:left; width:10%;">
                            <span>Precio/Ud</span>
                        </div>
                        <div class="text-right" style="font-weight:bolder; color:#4f4b4b; float:left; width:10%;">
                            <t t-if="display_discount">
                                <span>Dto(%)</span>
                            </t>
                            <t t-else="">
                                <span style="color:white;">Dto%</span>
                            </t>
                        </div>
                        <div class="text-right" style="font-weight:bolder; color:#4f4b4b; float:left; width:12%;">
                            <span>Valor neto</span>
                        </div>
                        <div class="text-right" style="font-weight:bolder; color:#4f4b4b; float:left; width:7%;">
                            <span>IVA</span>
                        </div>
                    </div>

                    <t t-foreach="lines_to_print" t-as="line">
                        <div style="clear:both; font-size:0.9em;">
                            <t t-if="line.display_type in ('line_section', 'line_note')">
                                <div class="text-left" style="width:100%;">
                                    <b><span t-field="line.name"/></b>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="text-left" style="width:13%; float:left;">
                                    <span t-if="line.product_id and line.product_id.default_code" t-field="line.product_id.default_code"/>
                                </div>
                                <div class="text-left" style="float:left; width:41%;">
                                    <t t-set="description_index" t-value="line.name.find(']') + 1 if line.name and line.name.find(']') != -1 else 0"/>
                                    <t t-set="line_description" t-value="line.name[description_index:].strip() if line.name else (line.product_id.display_name if line.product_id else '')"/>
                                    <span t-esc="line_description"/>
                                </div>
                                <div class="text-right" style="float:left; width:7%;">
                                    <span t-esc="round(line.product_qty, 2)"/>
                                </div>
                                <div class="text-right" style="float:left; width:10%;">
                                    <span t-out="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                                <div class="text-right" style="float:left; width:10%;">
                                    <t t-if="line.discount">
                                        <span t-field="line.discount"/>
                                    </t>
                                    <t t-else="">
                                        <span style="color:white;">aaa</span>
                                    </t>
                                </div>
                                <div class="text-right" style="float:left; width:12%;">
                                    <span t-out="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                                <div class="text-right" style="float:left; width:7%;">
                                    <span t-esc="', '.join([(str(int(tax.amount)) + '%' if tax.amount == int(tax.amount) else str(tax.amount) + '%') for tax in line.taxes_id])"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <hr style="height:2px; background-color:black; clear:both; margin:8px 0; border:0; opacity:1;"/>
                </div>

                <div style="width:50%; float:right; clear:both;">
                    <div style="width:60%; float:left;">
                        <span>Base Imponible</span>
                    </div>
                    <div style="width:40%; float:left; text-align:right;">
                        <span t-out="tax_totals.get('formatted_amount_untaxed', '')"/>
                    </div>

                    <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                        <t t-set="subtotal_name" t-value="subtotal.get('name', '')"/>
                        <t t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])" t-as="amount_by_group">
                            <div style="clear:both; width:60%; float:left;">
                                <span t-out="amount_by_group.get('tax_group_name', '')"/>
                                <t t-if="len(tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])) &gt; 1 or tax_totals.get('amount_untaxed', 0) != amount_by_group.get('tax_group_base_amount', 0)">
                                    <span> sobre </span>
                                    <span t-out="amount_by_group.get('formatted_tax_group_base_amount', '')"/>
                                </t>
                            </div>
                            <div style="width:40%; float:left; text-align:right;">
                                <span t-out="amount_by_group.get('formatted_tax_group_amount', '')"/>
                            </div>
                        </t>
                    </t>

                    <div style="font-weight:bolder; width:60%; float:left; clear:both; border-top:2px solid black;">
                        <span>Total</span>
                    </div>
                    <div style="width:40%; float:left; text-align:right; font-weight:bolder; border-top:2px solid black;">
                        <span t-out="tax_totals.get('formatted_amount_total', '')"/>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_purchase_document_dis_order" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <t t-call="document_format_dis.report_purchase_document_body"/>
                </t>
            </xpath>
        </template>

        <template id="report_purchase_document_dis_quotation" inherit_id="purchase.report_purchasequotation_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <t t-call="document_format_dis.report_purchase_document_body"/>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
