<?xml version="1.0" encoding="UTF-8"?>
<!-- Esta vista se encarga de mostrar los productos en las facturas, siempre que su precio sea mayor a 0 euros -->

<odoo>

    <data>

        <template id="document_format_dis.report_invoice_document_without_promotions">

            <t t-name="document_format_dis.report_invoice_document_without_promotions">
                <t t-set="esRect" t-value="o.type"></t>

                <!-- llamada a la cabecera y pie y declaración de variables -->
                <t t-set="doc" t-value="o"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="blu" t-value="0"/>
                <t t-call="web.external_layout_clean">

                    <!-- Empieza el contenido -->
                    <div class="page">

                        <!-- Lista de la izquierda -->
                        <div style="width:50%; float:left;margin-top:35px;">
                            <ul class="list-unstyled" style="list-style: none; padding-left: 0; margin: 0;">
                                <li style="margin-bottom: 5px;"
                                    t-if="o.type == 'out_invoice' and o.state in ('posted', 'in_payment', 'paid')">
                                    <b>Factura</b>
                                    <span t-field="o.name"/>
                                </li>
                                <li style="margin-bottom: 5px;" t-if="o.type == 'out_invoice' and o.state == 'draft'">
                                    <b>Borrador de factura</b>
                                    <span t-field="o.name"/>
                                </li>
                                <li style="margin-bottom: 5px;" t-if="o.type == 'out_invoice' and o.state == 'cancel'">
                                    <b>Factura cancelada</b>
                                    <span t-field="o.name"/>
                                </li>
                                <li style="margin-bottom: 5px;" t-if="o.type == 'out_refund'">
                                    <b>Factura Rectificativa</b>
                                    <span t-field="o.name"/>
                                </li>
                                <li style="margin-bottom: 5px;" t-if="o.type == 'in_refund'">
                                    <b>Vendor Credit Note</b>
                                    <span t-field="o.name"/>
                                </li>
                                <li style="margin-bottom: 5px;" t-if="o.type == 'in_invoice'">
                                    <b>Vendor Bill</b>
                                    <span t-field="o.name"/>
                                </li>

                                <li t-if="'delivery_zone_id' in doc and doc.delivery_zone_id"
                                    style="margin-bottom: 5px;">
                                    <b>Zona:</b>
                                    <span t-field="doc.delivery_zone_id"/>
                                </li>

                                <li style="margin-bottom: 5px;" t-if="o.invoice_date" name="invoice_date">
                                    <b>Fecha:</b>
                                    <span class="m-0" t-field="o.invoice_date"/>
                                </li>

                                <li style="margin-bottom: 5px;" t-if="o.invoice_origin" name="origin">
                                    <b>Origen:</b>
                                    <span class="m-0" t-field="o.invoice_origin"/>
                                </li>

                                <li style="margin-bottom: 5px;" t-if="o.partner_id.ref">
                                    <b>Ref. Cliente:</b>
                                    <span t-field="o.partner_id.ref"/>
                                </li>

                                <li style="margin-bottom: 5px;" t-if="o.type == 'out_refund'">
                                    <b>Motivo:</b>
                                    <span t-field="o.name"/>
                                </li>

                            </ul>

                            <!-- Lista de la derecha -->
                        </div>
                        <div style="width:50%;  float:left;margin-top:35px;">
                            <ul class="list-unstyled" style="list-style: none; padding-left: 0; margin: 0;">

                                <li style="margin-bottom: 5px;" t-if="o.partner_id.name">
                                    <span t-field="o.partner_id.name"/>
                                </li>

                                <li style="margin-bottom: 5px;"
                                    t-if="'comercial' in o.partner_id and o.partner_id.comercial">
                                    <span t-field="o.partner_id.comercial"/>
                                </li>


                                <li style="margin-bottom: 5px;" t-if="o.partner_id.street">
                                    <span t-field="o.partner_id.street"/>
                                </li>

                                <li>
                                    <span t-if="o.partner_id.zip" t-field="o.partner_id.zip"/>
                                    <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>,
                                    <span t-if="o.partner_id.country_id" t-field="o.partner_id.country_id"/>
                                </li>

                                <li style="margin-bottom: 5px;" t-if="o.partner_id.vat">
                                    CIF:
                                    <span t-field="o.partner_id.vat"/>
                                </li>

                            </ul>
                            <div style="margin-bottom: 5px;"
                                 t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                                <span>
                                    <b>Dirección de entrega:</b>
                                </span>
                                <ul class="list-unstyled">

                                    <li t-if="o.partner_shipping_id.name">
                                        <span t-field="o.partner_shipping_id.name"/>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Tabla con los productos -->
                        <div class="page">
                            <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>

                            <div style="width:100%;clear:both;">

                                <!--Cabecera de la tabla-->
                                <div
                                    style="border-bottom:2px solid black;border-right:2px solid black;border-top:2px solid black;border-left:1px solid black;height:25px;">

                                    <div class="text-left"
                                         style="font-weight:bolder; color:#4f4b4b;width:13%;float:left;">
                                        <span>Código</span>
                                    </div>

                                    <div class="text-left"
                                         style="font-weight:bolder; color:#4f4b4b;width:15%;float:left;">
                                        <span>Lote</span>
                                    </div>

                                    <div class="text-left"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:26%;">
                                        <span>Descripción</span>
                                    </div>


                                    <div class="text-right"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:7%;">
                                        <span>Uds.</span>
                                    </div>

                                    <div class="text-right"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:10%;">
                                        <span>Precio/Ud</span>
                                    </div>
                                    <div class="text-right" groups="sale.group_discount_per_so_line"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:10%;">
                                        <span>Des.(%)</span>
                                    </div>

                                    <div class="text-right"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:12%;">
                                        <span>Valor neto</span>
                                    </div>

                                    <div class="text-right"
                                         style="font-weight:bolder; color:#4f4b4b;float:left;width:7%;">
                                        <span>IVA</span>
                                    </div>

                                </div>

                                <!-- Fin cabecera -->

                            </div>

                            <!-- Lineas -->

                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-foreach="o.invoice_line_ids" t-as="line">

                                <t t-if="line.price_unit > 0.00">

                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                       groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                       groups="account.group_show_line_subtotals_tax_included"/>
                                    <div style="clear:both;font-size:0.9em;">

                                        <!-- si no es una nota -->

                                        <div t-if="line.product_id">


                                            <!-- Código -->
                                            <div class="text-left" style="width:13%;float:left;">
                                                <t t-if="line.product_id.default_code">
                                                    <span t-field="line.product_id.default_code"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:white">aaa</span>
                                                </t>
                                            </div>
                                            <!-- Fin codigo -->

                                            <!-- Lote -->
                                            <div class="text-left" style="width:15%;float:left;">
                                                <t t-if="line.prod_lot_ids">
                                                    <t t-foreach="line.prod_lot_ids" t-as="lot">
                                                        <span t-field="lot.name"/>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:white">aaa</span>
                                                </t>
                                            </div>
                                            <!-- Fin Lote -->

                                            <!-- descripción -->

                                            <div class="text-left" style="float:left;width:26%;">
                                                <t t-set="descripcion" t-value="line.name.find(']') +1"></t>
                                                <t t-set="linea" t-value="line.name[descripcion:]"></t>
                                                <span t-esc="linea"/>
                                            </div>

                                            <!-- Fin descripción -->
                                            <!-- UDS -->

                                            <div class="text-right" style="float:left;width:7%;">
                                                <span t-if="esRect == 'out_refund'">-</span>
                                                <span t-esc="round(line.quantity,2)"/>
                                            </div>

                                            <!-- Fin UDS -->

                                            <!-- Precio por unidad -->

                                            <div class="text-right" style="float:left;width:10%;">
                                                <span t-field="line.price_unit"/>
                                            </div>

                                            <!-- Fin precio unidad -->

                                            <!-- Descuento -->

                                            <div class="text-right" groups="sale.group_discount_per_so_line"
                                                 style="float:left;width:10%;">
                                                <span t-field="line.discount"/>
                                            </div>

                                            <!-- Fin descuento -->

                                            <!--  Valor Neto -->

                                            <div class="text-right" style="float:left;width:12%;">
                                                <span t-if="esRect == 'out_refund'">-</span>
                                                <span t-field="line.price_subtotal"
                                                      groups="account.group_show_line_subtotals_tax_excluded"/>
                                            </div>

                                            <!-- Fin valor neto -->

                                            <!-- IVA -->

                                            <div class="text-right" style="float:left;width:7%;">
                                                <t t-foreach="line.tax_ids" t-as="tax">
                                                    <div>
                                                        <span t-esc="round(tax.amount,2)"></span>%
                                                    </div>
                                                </t>
                                            </div>


                                            <!-- Fin IVA -->

                                        </div>

                                        <!-- fin si no es nota -->

                                        <!-- si es nota -->

                                        <div t-if="not line.product_id">

                                            <div class="text-left" style="width:100%;">
                                                <span t-field="line.name"/>
                                            </div>

                                        </div>

                                        <!-- fin si es nota -->

                                    </div>

                                </t>
                                <t t-else="">
                                    <div t-if="not line.product_id">

                                        <div class="text-left" style="width:100%;">
                                            <span t-field="line.name"/>
                                        </div>

                                    </div>
                                </t>
                            </t>

                            <!-- Fin lineas -->

                            <!-- Separador -->

                            <div style="height:2px;background-color:black;clear:both;"></div>

                            <!-- Fin separador -->

                            <!-- Totales -->
                            <div style="width:60%;float:right;clear:both">


                                <!-- Subtotal -->

                                <div style="width:40%;float:left">
                                    <span>Base Imponible</span>
                                </div>

                                <div style="width:60%;float:left;text-align:right">
                                    <span t-if="o.type == 'out_refund'">-</span>
                                    <span t-field="o.amount_untaxed"/>
                                </div>

                                <!-- Fin Subtotal -->

                                <!-- Impuestos -->

                                <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                    <t t-if="len(o.line_ids.filtered(lambda x: x.tax_line_id)) == 1 and o.amount_untaxed == amount_by_group[2]">
                                        <div style="width:40%;float:left;clear:both;">
                                            <span t-esc="amount_by_group[0]"/>
                                        </div>

                                        <div class="text-right o_price_total"
                                             style="width:60%;float:left;text-align:right">
                                            <span t-if="o.type == 'out_refund'">-</span>
                                            <span t-esc="amount_by_group[3]"/>
                                        </div>

                                    </t>
                                    <t t-else="">
                                        <div style="width:40%;float:left;clear:both;">
                                            <div style="clear:both;width:60%;float:left;">
                                                <span t-esc="amount_by_group[0]"/>
                                            </div>
                                        </div>

                                        <div class="text-right o_price_total"
                                             style="width:60%;float:left;text-align:right">
                                            <span t-if="o.type == 'out_refund'">-</span>
                                            <span t-esc="amount_by_group[3]"/>
                                        </div>
                                    </t>
                                </t>


                                <!-- Fin impuestos -->

                                <!-- Total -->

                                <div style="font-weight:bolder;width:40%;float:left;" id="total">
                                    <span>Total</span>
                                </div>
                                <div class="text-right">
                                    <span t-if="o.type == 'out_refund'">-</span>
                                    <span t-field="o.amount_total" style="font-weight:bolder;"/>
                                </div>

                                <!-- FIn total -->

                                <!-- Separador -->

                                <div style="height:2px;background-color:black;clear:both;"></div>

                                <!-- FIn Separador -->

                            </div>

                            <!-- Firma del cliente -->

                            <div
                                style="height:100px;width:100%;border:2px solid black; page-break-before: avoid !important;"
                                t-if="'digital_signature' in doc and doc.digital_signature">
                                <span style="text-align:center;display:block;width:100%;">Firma del cliente:</span>
                                <img style="width:100%;" t-attf-src="data:image/*;base64,{{doc.digital_signature}}"/>
                            </div>


                            <div class="clearfix" style="display:none;">
                                <div id="total" class="row">
                                    <div
                                        t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                                        <table style="border-bottom:4px solid black!important;width:100%;">
                                            <tr class="border-black o_subtotal" style="">
                                                <td style="">
                                                    <strong style="font-weight:bolder; color:black;">Subtotal</strong>
                                                </td>
                                                <td class="text-right">
                                                    <span style="color:#686565;" t-field="o.amount_untaxed"/>
                                                </td>
                                            </tr>
                                            <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                                                <tr style="">
                                                    <t t-if="len(o.line_ids.filtered(lambda l: l.tax_line_id)) == 1 and o.amount_untaxed == amount_by_group[2]">
                                                        <td style="width:65%;float:left;clear:both;text-align:left;">
                                                            <b>
                                                                <span t-esc="amount_by_group[0]"/>
                                                            </b>
                                                        </td>

                                                        <td class="text-right o_price_total"
                                                            style="width:35%;float:left;text-align:right">
                                                            <span t-if="o.type == 'out_refund'">-</span>
                                                            <span t-esc="amount_by_group[3]"/>
                                                        </td>

                                                    </t>
                                                    <t t-else="">
                                                        <td style="width:70%;float:left;clear:both;text-align:left;">
                                                            <div style="clear:both;float:left;width:65%;">
                                                                <b>
                                                                    <span t-esc="amount_by_group[0]"/>
                                                                </b>
                                                                <span>sobre</span>
                                                            </div>

                                                            <div style="text-align:right;float:left;width:35%;">
                                                                <span style="display:block;width:100%;">
                                                                    <t t-esc="amount_by_group[4]"/>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <td class="text-right o_price_total"
                                                            style="width:30%;float:left;text-align:right">
                                                            <span t-if="o.type == 'out_refund'">-</span>
                                                            <span t-esc="amount_by_group[3]"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                            <tr class="border-black o_total">
                                                <td>
                                                    <strong style="font-weight:bolder; color:black;">Total</strong>
                                                </td>
                                                <td class="text-right">
                                                    <span style="color:#686565;" t-field="o.amount_total"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>


                            <p t-if="o.ref" style="display:none;">
                                Please use the following communication for your payment :
                                <b>
                                    <span t-field="o.ref"/>
                                </b>
                            </p>

                        </div>

                    </div>


                </t>
            </t>


        </template>

    </data>

</odoo>
