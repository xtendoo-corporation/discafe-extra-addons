<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_promotions">
            <t t-name="document_format_dis.report_invoice_document_promotions">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-set="is_customer_refund" t-value="o.move_type == 'out_refund'"/>
                    <t t-set="promotion_lines" t-value="[line for line in o.invoice_line_ids if (((not line.display_type) or line.display_type == 'product') and line.product_id and line.price_unit == 0.0)]"/>
                    <t t-set="display_discount" t-value="any(line.discount for line in promotion_lines)"/>

                    <t t-if="promotion_lines">
                        <div class="page">
                            <!-- Comentario migración Odoo 18: la segunda página solo se imprime si existen líneas promocionales. -->
                            <div class="row mb-4">
                                <div class="col-6">
                                    <ul class="list-unstyled mb-0">
                                        <li>
                                            <strong>
                                                <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</t>
                                                <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Borrador de factura</t>
                                                <t t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura cancelada</t>
                                                <t t-elif="o.move_type == 'out_refund'">Factura Rectificativa</t>
                                                <t t-elif="o.move_type == 'in_refund'">Vendor Credit Note</t>
                                                <t t-elif="o.move_type == 'in_invoice'">Vendor Bill</t>
                                                <t t-else="">Factura</t>
                                            </strong>
                                            <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                                        </li>
                                        <li t-if="'delivery_zone_id' in o._fields and o.delivery_zone_id">
                                            <strong>Zona:</strong>
                                            <span t-field="o.delivery_zone_id"/>
                                        </li>
                                        <li t-if="o.invoice_date">
                                            <strong>Fecha:</strong>
                                            <span t-field="o.invoice_date"/>
                                        </li>
                                        <li t-if="o.invoice_origin">
                                            <strong>Origen:</strong>
                                            <span t-field="o.invoice_origin"/>
                                        </li>
                                        <li t-if="o.partner_id.ref">
                                            <strong>Ref. Cliente:</strong>
                                            <span t-field="o.partner_id.ref"/>
                                        </li>
                                        <li t-if="o.move_type == 'out_refund' and o.ref">
                                            <strong>Motivo:</strong>
                                            <span t-field="o.ref"/>
                                        </li>
                                    </ul>
                                </div>

                                <div class="col-6">
                                    <ul class="list-unstyled mb-0">
                                        <li t-if="o.partner_id.name"><span t-field="o.partner_id.name"/></li>
                                        <li t-if="'comercial' in o.partner_id._fields and o.partner_id.comercial"><span t-field="o.partner_id.comercial"/></li>
                                        <li t-if="o.partner_id.street"><span t-field="o.partner_id.street"/></li>
                                        <li>
                                            <span t-if="o.partner_id.zip" t-field="o.partner_id.zip"/>
                                            <span t-if="o.partner_id.city">
                                                <t t-if="o.partner_id.zip"> </t>
                                                <span t-field="o.partner_id.city"/>
                                            </span>
                                            <t t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id"/></t>
                                        </li>
                                        <li t-if="o.partner_id.vat">
                                            <strong>CIF:</strong>
                                            <span t-field="o.partner_id.vat"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div style="width:100%; text-align:center; font-size:1.3em; font-weight:bolder; margin-bottom: 12px;">
                                <p>Artículos en Promoción</p>
                            </div>

                            <table class="table table-sm table-borderless" style="font-size: 0.9em; width: 100%;">
                                <thead style="border-top: 2px solid black; border-bottom: 2px solid black;">
                                    <tr>
                                        <th class="text-start" style="width: 13%;">Código</th>
                                        <th class="text-start" style="width: 15%;">Lote</th>
                                        <th class="text-start" style="width: 26%;">Descripción</th>
                                        <th class="text-end" style="width: 7%;">Uds.</th>
                                        <th class="text-end" style="width: 10%;">Precio/Ud</th>
                                        <th t-if="display_discount" class="text-end" style="width: 10%;">Des.(%)</th>
                                        <th class="text-end" style="width: 12%;">Valor neto</th>
                                        <th class="text-end" style="width: 7%;">IVA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="promotion_lines" t-as="line">
                                        <t t-set="description_start" t-value="line.name.find(']') + 1 if line.name and ']' in line.name else 0"/>
                                        <t t-set="clean_description" t-value="line.name[description_start:].strip() if line.name else ''"/>
                                        <t t-set="tax_labels" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                        <tr style="border-bottom: 1px solid #000;">
                                            <td class="text-start">
                                                <span t-field="line.product_id.default_code"/>
                                            </td>
                                            <td class="text-start">
                                                <t t-if="'prod_lot_ids' in line._fields and line.prod_lot_ids">
                                                    <t t-foreach="line.prod_lot_ids" t-as="lot">
                                                        <span t-field="lot.name"/>
                                                    </t>
                                                </t>
                                            </td>
                                            <td class="text-start">
                                                <span t-esc="clean_description or line.product_id.display_name or line.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="is_customer_refund">-</span>
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <span t-field="line.price_unit"/>
                                            </td>
                                            <td t-if="display_discount" class="text-end">
                                                <span t-field="line.discount"/>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <span t-if="is_customer_refund">-</span>
                                                <span t-field="line.price_subtotal"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="tax_labels"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <hr style="height: 2px; background-color: black; clear: both; margin-bottom: 12px; border: 0; opacity: 1;"/>

                            <div t-if="('digital_signature' in o._fields and o.digital_signature) or ('signature' in o._fields and o.signature)" class="mt-4" style="width: 30%; border: 2px solid black; padding: 8px;">
                                <!-- Comentario migración Odoo 18: se soporta tanto firma legacy como firma estándar si existiera. -->
                                <span style="text-align: center; display: block; width: 100%;">Firma del cliente:</span>
                                <img t-if="'digital_signature' in o._fields and o.digital_signature" t-att-src="image_data_uri(o.digital_signature)" style="width: 100%; max-height: 4cm; object-fit: contain;"/>
                                <img t-elif="'signature' in o._fields and o.signature" t-att-src="image_data_uri(o.signature)" style="width: 100%; max-height: 4cm; object-fit: contain;"/>
                            </div>

                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>

</odoo>
