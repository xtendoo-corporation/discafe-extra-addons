<?xml version="1.0" encoding="UTF-8"?>
<!-- Esta vista se encarga de llamar a las dos vistas de Facturas -->
<!-- Este reporte se puede imprimir desde: Contabilidad > Clientes > Facturas > Imprimir > Factura -->
<odoo>

    <data>

        <!-- Definición del reporte para Facturas -->
        <report id="document_format_dis.report_invoice_promotions_print"
                string="Factura"
                model="account.move"
                report_type="qweb-pdf"
                name="document_format_dis.report_invoice_promotions"
                file="account.report_invoice_promotions"
                print_report_name="(object.type == 'out_invoice' and 'Factura - %s' % (object.name)) or 'Nota de Crédito - %s' % (object.name)"
        />

        <!-- Plantilla principal del reporte -->
        <template id="document_format_dis.report_invoice_promotions">
            <t t-name="document_format_dis.report_invoice_promotions">
                <t t-call="web.html_container">
                     <t t-foreach="docs" t-as="o">
                        <t t-call="document_format_dis.report_invoice_document_without_promotions" t-lang="o.partner_id.lang"/>
                        <t t-call="document_format_dis.report_invoice_document_promotions" t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
