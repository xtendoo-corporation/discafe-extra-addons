<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Comentario migración Odoo 18: acción equivalente al report legacy de factura. -->
        <record id="report_invoice_promotions_action" model="ir.actions.report">
            <field name="name">Factura</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">document_format_dis.report_invoice_promotions</field>
            <field name="report_file">document_format_dis.report_invoice_promotions</field>
            <field name="print_report_name">object._get_report_base_filename()</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_invoice_promotions">
            <!-- Comentario migración Odoo 18: se mantiene el flujo original sin promociones + promociones. -->
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                    <t t-call="document_format_dis.report_invoice_document_without_promotions" t-lang="lang"/>
                    <t t-call="document_format_dis.report_invoice_document_promotions" t-lang="lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
