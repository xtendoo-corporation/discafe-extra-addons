<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Comentario migración Odoo 18: acción de informe equivalente al <report> de Odoo 12. -->
        <record id="report_saleorder_promotions_print" model="ir.actions.report">
            <field name="name">Presupuesto / Pedido</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">document_format_dis.report_saleorder_promotions</field>
            <field name="report_file">document_format_dis.report_saleorder_promotions</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_saleorder_promotions">
            <!-- Comentario migración Odoo 18: se conserva el orden de impresión original de Odoo 12. -->
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="document_format_dis.report_saleorder_document_without_promotions" t-lang="doc.partner_id.lang"/>
                    <t t-call="document_format_dis.report_saleorder_document_promotions" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
