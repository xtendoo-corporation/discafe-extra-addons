<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_saleorder_document_without_promotions">
            <t t-name="document_format_dis.report_saleorder_document_without_promotions">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                    <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
                    <t t-set="lines_to_print" t-value="[l for l in doc.order_line if not l.display_type and l.price_unit &gt; 0.0]"/>
                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_print)"/>
                    <t t-set="tax_totals" t-value="doc.tax_totals"/>

                    <div class="page">
                        <!-- Comentario migración Odoo 18: se mantienen los bloques informativos del diseño original con guards para campos opcionales. -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <ul class="list-unstyled mb-0">
                                    <li>
                                        <strong>
                                            <t t-if="is_proforma">Factura Pro-Forma:</t>
                                            <t t-elif="doc.state in ['draft', 'sent']">Presupuesto:</t>
                                            <t t-else="">Pedido:</t>
                                        </strong>
                                        <span t-field="doc.name"/>
                                    </li>
                                    <li t-if="'delivery_zone_id' in doc._fields and doc.delivery_zone_id">
                                        <strong>Zona:</strong>
                                        <span t-field="doc.delivery_zone_id"/>
                                    </li>
                                    <li t-if="doc.date_order">
                                        <strong>Fecha:</strong>
                                        <span t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                                    </li>
                                    <li t-if="doc.client_order_ref">
                                        <strong>Ref. cliente:</strong>
                                        <span t-field="doc.client_order_ref"/>
                                    </li>
                                    <li t-if="doc.user_id">
                                        <strong>Comercial:</strong>
                                        <span t-field="doc.user_id"/>
                                    </li>
                                    <li t-if="doc.payment_term_id">
                                        <strong>Términos de pago:</strong>
                                        <span t-field="doc.payment_term_id"/>
                                    </li>
                                    <li t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                                        <strong>Fecha de validez:</strong>
                                        <span t-field="doc.validity_date"/>
                                    </li>
                                    <li t-if="doc.partner_id.ref">
                                        <strong>Ref. Cliente:</strong>
                                        <span t-field="doc.partner_id.ref"/>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-6">
                                <ul class="list-unstyled mb-0">
                                    <li t-if="'comercial' in doc.partner_id._fields and doc.partner_id.comercial">
                                        <span t-field="doc.partner_id.comercial"/>
                                    </li>
                                    <li t-if="doc.partner_id.name">
                                        <span t-field="doc.partner_id.name"/>
                                    </li>
                                    <li t-if="doc.partner_id.street">
                                        <span t-field="doc.partner_id.street"/>
                                    </li>
                                    <li>
                                        <span t-if="doc.partner_id.zip" t-field="doc.partner_id.zip"/>
                                        <span t-if="doc.partner_id.city">
                                            <t t-if="doc.partner_id.zip"> </t>
                                            <span t-field="doc.partner_id.city"/>
                                        </span>
                                        <t t-if="doc.partner_id.country_id">, <span t-field="doc.partner_id.country_id"/></t>
                                    </li>
                                    <li t-if="doc.partner_id.vat">
                                        <strong>CIF:</strong>
                                        <span t-field="doc.partner_id.vat"/>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <t t-if="(doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id) or (doc.partner_shipping_id != doc.partner_invoice_id)">
                            <div class="row mb-4">
                                <div class="col-6">
                                    <strong>
                                        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Dirección de facturación y envío:</t>
                                        <t t-else="">Dirección de facturación:</t>
                                    </strong>
                                    <div t-field="doc.partner_invoice_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                                </div>
                                <div class="col-6" t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                                    <strong>Dirección de envío:</strong>
                                    <div t-field="doc.partner_shipping_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                                </div>
                            </div>
                        </t>

                        <div class="oe_structure"/>

                        <!-- Comentario migración Odoo 18: tabla QWeb segura para campos custom y múltiples impuestos. -->
                        <table class="table table-sm table-borderless" style="font-size: 0.9em; width: 100%;">
                            <thead style="border-top: 2px solid black; border-bottom: 2px solid black;">
                                <tr>
                                    <th class="text-start" style="width: 13%;">Código</th>
                                    <th class="text-start" style="width: 15%;">Lote</th>
                                    <th class="text-start" style="width: 26%;">Descripción</th>
                                    <th class="text-end" style="width: 7%;">Uds.</th>
                                    <th class="text-end" style="width: 10%;">Precio/Ud</th>
                                    <th t-if="display_discount" class="text-end" style="width: 10%;" groups="product.group_discount_per_so_line">Dto(%)</th>
                                    <th class="text-end" style="width: 12%;">Valor neto</th>
                                    <th class="text-end" style="width: 7%;">IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines_to_print" t-as="line">
                                    <tr style="border-bottom: 1px solid #000;">
                                        <td class="text-start">
                                            <span t-field="line.product_id.default_code"/>
                                        </td>
                                        <td class="text-start">
                                            <t t-if="'lot_id' in line._fields and line.lot_id">
                                                <span t-field="line.lot_id.name"/>
                                            </t>
                                        </td>
                                        <td class="text-start">
                                            <t t-set="description_start" t-value="line.name.find(']') + 1 if line.name and ']' in line.name else 0"/>
                                            <t t-set="clean_description" t-value="line.name[description_start:].strip() if line.name else ''"/>
                                            <span t-esc="clean_description or line.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line">
                                            <span t-if="line.discount" t-field="line.discount"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-set="tax_labels" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                            <span t-esc="tax_labels"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <hr style="height: 2px; background-color: black; clear: both; margin-bottom: 12px; border: 0; opacity: 1;"/>

                        <div class="row justify-content-end">
                            <div class="col-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td><strong>Base Imponible</strong></td>
                                        <td class="text-end"><span t-out="tax_totals.get('formatted_amount_untaxed', '')"/></td>
                                    </tr>
                                    <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                                        <t t-set="subtotal_name" t-value="subtotal.get('name', '')"/>
                                        <t t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])" t-as="amount_by_group">
                                            <tr>
                                                <td>
                                                    <span t-out="amount_by_group.get('tax_group_name', '')"/>
                                                    <t t-if="len(tax_totals.get('groups_by_subtotal', {}).get(subtotal_name, [])) &gt; 1 or tax_totals.get('amount_untaxed', 0) != amount_by_group.get('tax_group_base_amount', 0)">
                                                        <span> sobre </span>
                                                        <span t-out="amount_by_group.get('formatted_tax_group_base_amount', '')"/>
                                                    </t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="amount_by_group.get('formatted_tax_group_amount', '')"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr style="border-top: 2px solid black; font-weight: bold;">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><span t-out="tax_totals.get('formatted_amount_total', '')"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="mt-3">
                            <span t-field="doc.note"/>
                            <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)">
                                <strong>Observación de la posición fiscal</strong>
                                <span t-field="doc.fiscal_position_id.sudo().note"/>
                            </p>
                        </div>

                        <div t-if="doc.signature" class="mt-4" style="width: 30%; border: 2px solid black; padding: 8px;">
                            <!-- Comentario migración Odoo 18: se usa la firma estándar de sale.order en lugar de digital_signature. -->
                            <span style="text-align: center; display: block; width: 100%;">Firma del cliente:</span>
                            <img t-att-src="image_data_uri(doc.signature)" style="width: 100%; max-height: 4cm; object-fit: contain;"/>
                            <div class="text-center" t-if="doc.signed_by">
                                <span t-field="doc.signed_by"/>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </template>

    </data>

</odoo>
