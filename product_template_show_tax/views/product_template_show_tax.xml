<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Agregar campo taxes_id a la vista de lista de product.template -->
        <record model="ir.ui.view" id="product_template_tree_show_tax">
            <field name="name">product.template.tree.show.tax</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="taxes_id" string="Impuestos de clientes" widget="many2many_tags" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
