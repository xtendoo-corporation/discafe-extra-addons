<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

     <template id="report_sale_delivery_zone">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="xtendoo_partner_delivery_zone.report_sale_delivery_zone_document"/>
            </t>
        </t>
    </template>

    <template id="report_sale_delivery_zone_document">
        <t t-call="web.external_layout">
            <div class="page" style="font-size: 13px; color: #333333; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                <div class="oe_structure"/>

                <!-- Titulo Principal -->
                <div style="margin-bottom: 30px; border-bottom: 3px solid #2c5aa0; padding-bottom: 15px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <p style="margin: 0; font-size: 10px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Zona de Entrega</p>
                            <h1 style="margin: 8px 0 0 0; font-size: 28px; color: #2c5aa0; font-weight: 700;">
                                <span t-field="doc.name"/>
                            </h1>
                        </div>
                        <div style="text-align: right;">
                            <p style="margin: 0; font-size: 10px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Fecha del Reporte</p>
                            <p style="margin: 8px 0 0 0; font-size: 18px; color: #2c5aa0; font-weight: 700;">
                                <span t-esc="date_report"/>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Quotations -->
                <div style="margin-bottom: 25px; ">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0; ">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                               <th colspan="3" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">📋 Presupuestos</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 20%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Presupuesto</th>
                                <th style="width: 55%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Cliente</th>
                                <th style="width: 25%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="quotations" t-value="get_quotations_delivery_zone_date(doc.id, date_report)"/>
                            <t t-set="quotation_subtotal" t-value="0"/>
                            <t t-foreach="quotations" t-as="quotation">
                                <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;" t-if="quotation_index % 2 == 0">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="quotation.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="quotation.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="quotation.amount_total"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;" t-else="">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="quotation.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="quotation.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="quotation.amount_total"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="quotation_subtotal" t-value="quotation_subtotal + quotation.amount_total"/>
                            </t>
                        </tbody>
                    </table>
                    <!-- Total Presupuestos - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #e8eef7; font-weight: 700; color: #2c5aa0;">
                            <td style="width: 20%; padding: 12px 8px; border: 1px solid #2c5aa0;"/>
                            <td style="width: 55%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: left;">
                                Total Presupuestos
                            </td>
                            <td style="width: 25%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right;">
                                <span t-esc="quotation_subtotal"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Sale Order -->
                <div style="margin-bottom: 25px; ">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0; ">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                               <th colspan="3" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">📦 Pedidos Pendientes de Facturar</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 20%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Pedido</th>
                                <th style="width: 55%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Cliente</th>
                                <th style="width: 25%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sale_orders" t-value="get_sale_orders_delivery_zone_date(doc.id, date_report)"/>
                            <t t-set="sale_order_subtotal" t-value="0"/>
                            <t t-foreach="sale_orders" t-as="sale_order">
                                <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;" t-if="sale_order_index % 2 == 0">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="sale_order.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="sale_order.partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="sale_order.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="sale_order.amount_total"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;" t-else="">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="sale_order.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="sale_order.partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="sale_order.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="sale_order.amount_total"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="sale_order_subtotal"
                                    t-value="sale_order_subtotal + sale_order.amount_total"/>
                            </t>
                        </tbody>
                    </table>
                    <!-- Total Pedidos - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #e8eef7; font-weight: 700; color: #2c5aa0;">
                            <td style="width: 20%; padding: 12px 8px; border: 1px solid #2c5aa0;"/>
                            <td style="width: 55%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: left;">
                                Total Pedidos Pendientes de Facturar
                            </td>
                            <td style="width: 25%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right;">
                                <span t-esc="sale_order_subtotal"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Picking

                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th style="width: 25%">Albaran</th>
                            <th style="width: 75%">Cliente</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="pickings" t-value="get_pickings_delivery_zone_date(doc.id, date_report)"/>
                        <t t-foreach="pickings" t-as="picking">
                            <tr>
                                <td>
                                    <span t-esc="picking.name"/>
                                </td>
                                <td>
                                    <span t-esc="picking.partner_id.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot style="page-break-inside: avoid;">
                        <tr>
                            <td>
                                <strong>Total Albaranes</strong>
                            </td>
                            <td align="right">
                                <strong>
                                    <span t-esc="len(pickings)"/>
                                </strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
                -->

                <!-- Invoice -->
                <div style="margin-bottom: 25px; ">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0; ">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                               <th colspan="4" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">🧾 Facturas</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 18%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Factura</th>
                                <th style="width: 38%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Cliente</th>
                                <th style="width: 22%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                                <th style="width: 22%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Pagado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="invoices" t-value="get_invoices_delivery_zone_date(doc.id, date_report)"/>
                            <t t-set="invoice_subtotal" t-value="0"/>
                            <t t-set="invoice_payments" t-value="0"/>
                            <t t-foreach="invoices" t-as="invoice">
                                <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;" t-if="invoice_index % 2 == 0">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="invoice[0].name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="invoice[0].partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="invoice[0].partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="invoice[0].amount_total_signed"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="invoice[1]"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;" t-else="">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="invoice[0].name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="invoice[0].partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="invoice[0].partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="invoice[0].amount_total_signed"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="invoice[1]"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="invoice_subtotal"
                                    t-value="invoice_subtotal + invoice[0].amount_total_signed"/>
                                <t t-set="invoice_payments"
                                    t-value="invoice_payments + invoice[1]"/>
                            </t>
                        </tbody>
                    </table>
                    <!-- Total Facturas - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #e8eef7; font-weight: 700; color: #2c5aa0;">
                            <td style="width: 18%; padding: 12px 8px; border: 1px solid #2c5aa0;"/>
                            <td style="width: 38%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: left;">
                                Total Facturas
                            </td>
                            <td style="width: 22%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right;">
                                <span t-esc="invoice_subtotal"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td style="width: 22%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right; color: #333333;">
                                <span t-esc="invoice_payments"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Payment -->
                <div style="margin-bottom: 25px; ">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0; ">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                               <th colspan="3" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">💳 Pagos Individuales</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 20%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Pago</th>
                                <th style="width: 55%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Cliente</th>
                                <th style="width: 25%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="payments" t-value="get_payments_delivery_zone_date(doc.id, date_report)"/>
                            <t t-set="payment_subtotal" t-value="0"/>
                            <t t-foreach="payments" t-as="payment">
                                <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;" t-if="payment_index % 2 == 0">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="payment.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="payment.partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="payment.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="payment.amount"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;" t-else="">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="payment.name" style="font-weight: 500; color: #2c5aa0;"/>
                                    </td>
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0;">
                                        <span t-esc="payment.partner_id.ref" style="font-weight: 600; color: #666;"/>-
                                        <span t-esc="payment.partner_id.display_name"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="payment.amount"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="payment_subtotal" t-value="payment_subtotal + payment.amount"/>
                            </t>
                        </tbody>
                    </table>
                    <!-- Total Pagos - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #e8eef7; font-weight: 700; color: #2c5aa0;">
                            <td style="width: 20%; padding: 12px 8px; border: 1px solid #2c5aa0;"/>
                            <td style="width: 55%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: left;">
                                Total Pagos
                            </td>
                            <td style="width: 25%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right; color: #333333;">
                                <span t-esc="payment_subtotal"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Payment Grouped -->
                <div style="margin-bottom: 25px;">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0; ">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                               <th colspan="2" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">🏦 Resumen por Forma de Pago</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 75%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Forma de Pago</th>
                                <th style="width: 25%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="payments_journals" t-value="get_grouped_payments_delivery_zone_date(doc.id, date_report)"/>
                            <t t-set="payment_grouped_subtotal" t-value="0"/>
                            <t t-foreach="payments_journals" t-as="payment_journal">
                                <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;" t-if="payment_journal_index % 2 == 0">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="payment_journal['journal_id'][1]" style="color: #333;"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="payment_journal['amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;" t-else="">
                                    <td style="padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500;">
                                        <span t-esc="payment_journal['journal_id'][1]" style="color: #333;"/>
                                    </td>
                                    <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                        <span t-esc="payment_journal['amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="payment_grouped_subtotal" t-value="payment_grouped_subtotal + payment_journal['amount']"/>
                            </t>
                        </tbody>
                    </table>
                    <!-- Total Forma de Pago - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #e8eef7; font-weight: 700; color: #2c5aa0;">
                            <td style="width: 75%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: left;">
                                Total Pagos
                            </td>
                            <td style="width: 25%; padding: 12px 8px; border: 1px solid #2c5aa0; text-align: right; color: #333333;">
                                <span t-esc="payment_grouped_subtotal"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Resumen Diario - Destacado -->
                <div style="margin-bottom: 25px; page-break-inside: avoid;">
                    <table class="table table-condensed" style="width: 100%; border-collapse: collapse; margin: 0;">
                        <thead>
                            <tr style="background-color: #f5f5f5; border: none !important;">
                                <th colspan="2" style="padding: 12px 8px; text-align: left; font-size: 14px; font-weight: 700; color: #2c5aa0; text-transform: uppercase; letter-spacing: 0.5px; border: none !important;">📊 Resumen Diario</th>
                            </tr>
                            <tr style="background-color: #2c5aa0; color: white; font-weight: 600;">
                                <th style="width: 75%; padding: 12px 8px; text-align: left; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Concepto</th>
                                <th style="width: 25%; padding: 12px 8px; text-align: right; font-size: 12px; border: 1px solid #e0e0e0; color: white;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;">
                                <td style="padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">Total Presupuestos</td>
                                <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                    <span t-esc="quotation_subtotal"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="background-color: white; border-bottom: 1px solid #e0e0e0;">
                                <td style="padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">Total Pedidos Pendientes</td>
                                <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                    <span t-esc="sale_order_subtotal"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;">
                                <td style="padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">Total Facturado</td>
                                <td style="padding: 10px 8px; text-align: right; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                    <span t-esc="invoice_subtotal"
                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- Total Cobrado - Fuera de tabla -->
                    <table style="width: 100%; border-collapse: collapse; margin: 0;">
                        <tr style="background-color: #f9fafb; border-bottom: 1px solid #e0e0e0;">
                            <td style="width: 75%; padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500; color: #333333;">
                                Total Cobrado
                            </td>
                            <td style="width: 25%; padding: 10px 8px; border: 1px solid #e0e0e0; font-weight: 500; text-align: right; color: #333333;">
                                <span t-esc="payment_subtotal + invoice_payments"
                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

    <!-- Comentario migración Odoo 18: se usa un XML ID nuevo para evitar colisión con report_sale existente como ir.ui.view. -->
    <record id="report_sale_action" model="ir.actions.report">
        <field name="name">Sale Report</field>
        <field name="model">partner.delivery.zone</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">xtendoo_partner_delivery_zone.report_sale_delivery_zone</field>
        <field name="report_file">xtendoo_partner_delivery_zone.report_sale_delivery_zone</field>
    </record>

    </data>
</odoo>
