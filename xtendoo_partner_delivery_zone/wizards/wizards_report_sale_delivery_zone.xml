<?xml version="1.0"?>
<odoo>

    <!-- Definición del wizard para el reporte -->
    <record id="wizard_report_sale_delivery_zone" model="ir.ui.view">
        <field name="name">wizard_report_sale_delivery_zone</field>
        <field name="model">wizard.report.sale.delivery.zone</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_report"/>
                </group>
                <footer>
                    <button string="Select"
                            name="action_print_report"
                            type="object"
                            default_focus="1"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para el reporte que abrirá el wizard -->
    <record id="action_report_sale_delivery_zone" model="ir.actions.act_window">
        <field name="name">Report Sales Delivery Zones</field>
        <field name="res_model">wizard.report.sale.delivery.zone</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'active_ids': active_ids}</field>
    </record>

    <!-- Acción para el reporte que aparecerá en el menú de acciones -->
    <record id="partner_delivery_zone_wizard_action" model="ir.actions.act_window">
        <field name="name">Informe por fecha</field>
        <field name="res_model">wizard.report.sale.delivery.zone</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[]</field>
        <field name="groups_id" eval="[(6,0,[ref('base.group_partner_manager')])]"/>
        <field name="context">{'active_ids': active_ids}</field>
    </record>

    <!-- Agregar la acción al menú de acciones del modelo 'partner.delivery.zone' -->
    <record id="action_partner_delivery_zone_report" model="ir.actions.server">
        <field name="name">Informe por fecha</field>
        <field name="model_id" ref="model_partner_delivery_zone"/>
        <field name="binding_model_id" ref="model_partner_delivery_zone"/>
        <field name="state">code</field>
        <field name="code">action = env['partner.delivery.zone'].get_report_action(env.context.get('active_ids', [])) ;action</field>
    </record>


</odoo>
