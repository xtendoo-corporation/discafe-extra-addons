<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="account_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="replace">
            </xpath>
             <xpath expr="//field[@name='delivery_date']" position="after">
                 <field name="invoice_user_id"/>
               <field name="can_edit_delivery_zone" invisible="1"/>
               <field name="delivery_zone_id" readonly="not can_edit_delivery_zone" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
