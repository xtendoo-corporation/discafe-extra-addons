<odoo>

    <record id="view_partner_delivery_zone_form" model="ir.ui.view">
        <field name="name">partner.delivery.zone.form</field>
        <field name="model">partner.delivery.zone</field>
        <field name="arch" type="xml">
            <form string="Zona de Entrega">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Clientes">
                            <field name="partner_zones_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="ref" string="Ref"/>
                                    <field name="partner_id" string="Cliente"/>
                                    <field name="city" string="Ciudad"/>
                                    <field name="state_id" string="Provincia"/>
                                    <field name="zip" string="CP"/>
                                    <field name="phone" string="Teléfono"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Extiende la acción del módulo OCA partner_delivery_zone -->
    <record id="partner_delivery_zone.partner_delivery_zone_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="partner_delivery_zone_menu"
              name="Zonas de Entrega"
              parent="sale.menu_sales_config"
              action="partner_delivery_zone.partner_delivery_zone_action"
              sequence="30"/>

</odoo>
