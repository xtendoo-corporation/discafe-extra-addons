<odoo>

    <record id="view_account_payment_register_form_delivery_zone" model="ir.ui.view">
        <field name="name">account.payment.register.delivery.zone.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="can_edit_delivery_zone" invisible="1"/>
                <field name="delivery_zone_id"
                       readonly="not can_edit_delivery_zone"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
